# Guidely Frontend Environment Configuration Example
# Set this to your deployed backend or local server URL
VITE_API_BASE_URL=https://guidely-server-ccg1.onrender.com/api/
VITE_API_URL=https://guidely-server-ccg1.onrender.com/api/
VITE_WS_URL=wss://guidely-server-ccg1.onrender.com/ws

# Google OAuth 2.0 (Google Identity Services)
# Google OAuth Client ID created in Google Cloud Console Credentials (Web Client)
# Note: Keep CLIENT SECRET strictly on the server backend; do not expose secret in client env!
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

