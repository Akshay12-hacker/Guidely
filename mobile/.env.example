# Guidely Mobile Environment Configuration Example
# Copy to .env and configure for your environment

# Live Production Backend (Render)
EXPO_PUBLIC_API_URL=https://guidely-server-ccg1.onrender.com/api
EXPO_PUBLIC_WS_URL=wss://guidely-server-ccg1.onrender.com

# For Local Backend Development (port 5000):
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:5000
# iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_WS_URL=ws://localhost:5000
