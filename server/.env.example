# ==============================================================================
# Guidely Server Environment Configuration Template (.env.example)
# ==============================================================================

# Server Network & Environment Mode
PORT=5000
NODE_ENV=development

# Security & Authentication (JWT & Password Hashing)
JWT_SECRET=your_production_secret_key_change_me_in_prod_min_32_chars!
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration (MongoDB Atlas Cloud or Local MongoDB)
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/guidely
# MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/guidely?retryWrites=true&w=majority
MONGODB_DB_NAME=guidely
MONGODB_TIMEOUT_MS=5000

# CORS & Client Application Origins (comma-separated list or single URL)
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Initial Data Seeding (Set to 'true' to populate comprehensive Guidely dataset)
SEED_DEMO_DATA=false

# WebSocket & Server Telemetry
WS_HEARTBEAT_INTERVAL_MS=30000

# Express Request Body Size Limit
BODY_LIMIT=10mb

# Logging & Observability (Render & Production)
# LOG_LEVEL options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# LOG_FORMAT: 'json' (recommended for Render & production) or 'pretty' (for local dev)
LOG_FORMAT=pretty

# Rate Limiting (Security & Abuse Prevention)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=true

# Cloudinary Media Management (Production Media Storage)
CLOUDINARY_CLOUD_NAME=Guidely
CLOUDINARY_API_KEY=721675214645412
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
