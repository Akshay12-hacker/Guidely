# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_production_secret_key_change_me_in_prod_min_32_chars!
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/guidely
# MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/guidely?retryWrites=true&w=majority

# CORS Configuration (Set to your deployed frontend domain or comma-separated list)
CLIENT_ORIGIN=https://guidely.dev,https://guidely-app.vercel.app

# Seed Configuration (Set to 'true' only if you want initial mock demo data)
SEED_DEMO_DATA=false
